# Copy to .env and fill in values. Never commit real secrets.
# Used for local non-Docker runs (uvicorn + docker compose only for db/redis).
# Full Docker demo does not need this file — see docker-compose.yml environment.


# Only variables without defaults or requiring actual secrets:
DATABASE_URL=postgresql+asyncpg://b2b_admin:secret_password123@localhost:5433/b2b_platform
TEST_DATABASE_URL=postgresql+asyncpg://b2b_admin:secret_password123@localhost:5433/b2b_platform_test
SECRET_KEY=change-me-to-a-long-random-string

# To test AI features locally, override the default (False) here:
# SEMANTIC_SEARCH_ENABLED=true